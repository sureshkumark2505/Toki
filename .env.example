# Google Gemini AI API Key
GEMINI_API_KEY=

# Database Connection URL:
# 1. Local SQLite (Default for quick local development):
DATABASE_URL=sqlite:///./coach.db
# 2. Supabase PostgreSQL (Production / Cloud):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# App Environment & Security
JWT_SECRET=change-me-before-production
APP_ENV=development
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
GEMINI_MODEL=gemini-3.5-flash
CORS_ORIGINS=http://localhost:3000

